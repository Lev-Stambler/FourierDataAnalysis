{
  "schema": "research-control-v1",
  "experiment_id": "expv2-2-full-transformer-control-h100-v1",
  "hypothesis": "The debugged AdamW recipe—direct training for delay and associative recall plus concurrent-edge, mixed-composition, and hard fine-tune phases for two-hop recall—will achieve at least 95% Transformer ID accuracy on all full training distributions, making isolated OOD metrics scientifically interpretable.",
  "working_directory": "../..",
  "policy": {
    "pilot_max_dollars": 25.0,
    "pilot_max_gpu_hours": 1.0,
    "scale_tokens_per_parameter": 20.0
  },
  "data_artifacts": [],
  "source_artifacts": [
    {"path": "expv2/exp1/model.py"},
    {"path": "expv2/exp2/synthetic.py"},
    {"path": "expv2/exp2/training.py"},
    {"path": "expv2/exp2/two_hop_debug.py"},
    {"path": "expv2/exp2/full_control.py"},
    {"path": "expv2/exp2/preflight.py"},
    {"path": "expv2/exp2/remote_runner.py"}
  ],
  "stages": [
    {
      "id": "local-audit",
      "tier": "local",
      "command": [
        "uv", "run", "--no-sync", "python", "-m", "expv2.exp2", "audit",
        "--output={state_root}/stages/local-audit/result.json"
      ],
      "requires": [],
      "local_checks": [],
      "data_artifacts": [],
      "result_path": "{state_root}/stages/local-audit/result.json"
    },
    {
      "id": "h100-full-control",
      "tier": "pilot",
      "command": [
        "uv", "run", "--no-sync", "python", "-m", "expv2.exp2.remote_runner",
        "--repo-root={manifest_dir}",
        "--local-output={state_root}/stages/h100-full-control/artifacts",
        "--result={state_root}/stages/h100-full-control/result.json",
        "--campaign=full-control"
      ],
      "requires": ["local-audit"],
      "local_checks": [],
      "data_artifacts": [],
      "gpu_count": 1,
      "price_per_gpu_hour": 2.74,
      "max_wall_seconds": 3600,
      "result_path": "{state_root}/stages/h100-full-control/result.json",
      "pause_command": [
        "uv", "run", "--no-sync", "python", "-m", "expv2.exp2",
        "delete-service-now"
      ]
    }
  ]
}
